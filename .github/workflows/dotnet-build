name: Build .NET Project # Name of the workflow

on:
  push:
    branches:
      - main  

jobs:
  dotnet-build:
    name: Build .NET 6 Project
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4  # Checks out the code from the repository

      - name: Set up .NET 6
        uses: actions/setup-dotnet@v4  # Sets up .NET 6 on the runner
        with:
          dotnet-version: '6.0.x'

      - name: Restore dependencies
        run: dotnet restore  # Restores project dependencies

      # - name: Build the project
      #   run: dotnet build --configuration Release  # Not needed if publishing next

      - name: Publish the project
        run: dotnet publish --configuration Release --output ./publish  # Publishes the project
